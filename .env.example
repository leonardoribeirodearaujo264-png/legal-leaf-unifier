# Copie este arquivo para .env.local e preencha os valores
# Obtenha as chaves em: https://supabase.com/dashboard → Settings → API

VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Variáveis de servidor — configure em: Vercel Dashboard → Settings → Environment Variables
# NUNCA use prefixo VITE_ nestas chaves (ficam apenas no servidor, nunca no browser)
#
# DATAJUD_API_KEY=<sua_chave_base64>
# DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
#
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-proj-...
